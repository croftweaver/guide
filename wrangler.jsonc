// Cloudflare Worker that serves the built site from dist/ as static assets, with no code of its own
// (there is no `main`, and no functions/ folder: the Pages Functions of the starter do not run here).
// guide.croftweaver.com is attached as a Custom Domain by `routes` below: the deploy writes its DNS
// record. The workers.dev address stays off; Previews (npm run deploy:preview) still answer.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "croftweaver-guide",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [{ "pattern": "guide.croftweaver.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
